# ==============================================================================
# EduGuard AI - Environment Configuration Example
# Copy this file to .env and fill in your values:
#   Copy-Item .env.example .env
# ==============================================================================

# Google Gemini API Key (Optional: for natural language recommendation summaries)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (e.g., gemini-2.5-flash or gemini-2.5-pro)
GEMINI_MODEL=gemini-2.5-flash

