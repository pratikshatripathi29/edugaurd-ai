# ==============================================================================
# EduGuard AI - Git Ignore
# ==============================================================================

# Virtual Environment
.venv/
venv/
ENV/
env/

# Environment Variables & Secrets
.env
.env.local
*.env

# Raw Datasets (protect source datasets and avoid committing large binary/CSV dumps)
data/raw/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Databases & SQLite
*.db
*.sqlite
*.sqlite3

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# IDE and OS Metadata
.vscode/
.idea/
.DS_Store
Thumbs.db

# Streamlit Local Cache
.streamlit/

